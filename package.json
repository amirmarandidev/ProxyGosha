{
  "name": "proxy-gosha",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "description": "Telegram WEB Proxy for Cloudflare Workers",
  "scripts": {
    "dev:ts": "wrangler dev src/index.ts",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --name proxy-gosha-ts-staging",
    "deploy:baseline": "wrangler deploy --config wrangler.baseline.jsonc",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "check": "npm run test && npm run typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "smoke:worker": "node scripts/smoke-wrangler.mjs",
    "test:e2e": "node scripts/e2e-wrangler.mjs",
    "test:tcp-integration": "node --experimental-strip-types --test tests/integration/tcp-loopback.test.mjs",
    "test:protocol-diff": "node --experimental-strip-types --test tests/integration/protocol-differential.test.mjs",
    "test:workerd-tcp": "node --experimental-strip-types scripts/e2e-tcp-wrangler.mjs",
    "check:compatibility-date": "node scripts/check-compatibility-date.mjs",
    "test:workerd-tcp:lanes": "node --experimental-strip-types scripts/e2e-tcp-lanes-wrangler.mjs",
    "test:workerd-tcp:all": "npm run test:workerd-tcp && npm run test:workerd-tcp:lanes",
    "test:dc-health": "node --experimental-strip-types --test tests/unit/dc-health.test.mjs",
    "test:control-plane": "node --experimental-strip-types --test tests/unit/control-plane.test.mjs",
    "test:all": "npm run check && npm run test:protocol-diff && npm run test:tcp-integration && npm run test:control-plane && npm run test:dc-health",
    "ci": "npm run test:all && npm run build",
    "bench:core": "node --experimental-strip-types scripts/bench-core.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "wrangler": "4.162.0"
  }
}
